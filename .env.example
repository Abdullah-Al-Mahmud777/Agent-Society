# Alibaba Cloud Qwen (via OpenRouter) API Configuration
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Google Gemini API Configuration (drop-in replacement — same slot as Qwen)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: used when no model is stored in the provider config
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated fallback chain used after the primary model fails
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash

# AI retry/backoff configuration for transient 429/5xx provider errors
AI_MAX_RETRIES=3
AI_RETRY_BASE_DELAY_MS=1000
AI_RETRY_MAX_DELAY_MS=12000
AI_REQUEST_TIMEOUT_MS=45000
AI_TOTAL_TIMEOUT_MS=60000

# Maximum agents executed concurrently in parallel mode (1-8, default 3)
AI_MAX_CONCURRENT_AGENTS=3

# OpenAI API Configuration (Optional)
# OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Configuration (Optional)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Default Provider Configuration (for Vercel deployment)
# Used as a fallback when no active provider is stored for the account
DEFAULT_PROVIDER=qwen
DEFAULT_MODEL=qwen/qwen3.7-plus

# Server-side API key encryption (CHANGE IN PRODUCTION!)
# Generate with: openssl rand -hex 32
API_KEY_ENCRYPTION_SECRET=your-secure-random-secret-change-in-production

# Legacy key kept only to decrypt pre-v1 provider keys
NEXT_PUBLIC_ENCRYPTION_KEY=your-secure-random-key-change-in-production

# Session lifetime in days (optional, defaults to 30)
SESSION_TTL_DAYS=30

# Turso Cloud Database
TURSO_DATABASE_URL=libsql://your-database.turso.io
# Get a token with: turso db tokens create <database-name>
TURSO_AUTH_TOKEN=your_turso_auth_token
# Maximum simultaneous Turso requests per server process (1-20, default 4)
TURSO_CONCURRENCY=4
