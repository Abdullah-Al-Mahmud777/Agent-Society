# Alibaba Cloud Qwen (via OpenRouter) API Configuration
OPENROUTER_API_KEY=your-openrouter-api-key-here

# OpenAI API Configuration (Optional)
# OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Configuration (Optional)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Default Provider Configuration (for Vercel deployment)
# This is used as fallback when localStorage is not available
DEFAULT_PROVIDER=qwen
DEFAULT_MODEL=qwen/qwen3.7-plus

# Encryption Key for API Keys (CHANGE IN PRODUCTION!)
NEXT_PUBLIC_ENCRYPTION_KEY=your-secure-random-key-change-in-production

# Production Database (Optional - for multi-user support)
# POSTGRES_URL=your-postgres-connection-string
# DATABASE_URL=your-database-connection-string
